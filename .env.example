# ==============================================================================
# CommerceAI Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database: Cloud PostgreSQL (Neon, Supabase, Vercel Postgres, AWS RDS)
# ------------------------------------------------------------------------------
# Replace with your production Cloud PostgreSQL connection string:
# Neon format: postgresql://[user]:[password]@[endpoint]-pooler.ap-southeast-1.aws.neon.tech/[dbname]?sslmode=require
# Supabase format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Optional direct connection URL for migration tools if using pooled connections:
# DIRECT_URL="postgresql://username:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# AI Provider (OpenAI / Gemini / Mock fallback)
# ------------------------------------------------------------------------------
# Leave empty to use built-in deterministic MockAIProvider
AI_API_KEY=""
AI_MODEL="gpt-4o"
AI_BASE_URL="https://api.openai.com/v1"

# Or use Google Gemini:
# GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Metricool Integration (TikTok Account: @onesecond.id3)
# ------------------------------------------------------------------------------
# Configurable either here or dynamically via CommerceAI Settings (/settings)
METRICOOL_USER_TOKEN=""
METRICOOL_USER_ID=""
METRICOOL_BRAND_ID=""

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CommerceAI"
NODE_ENV="development"
